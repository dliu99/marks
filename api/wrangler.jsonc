{
  "name": "marks-backend",
  "compatibility_date": "2026-01-19",
  "main": "src/index.ts",
  "tsconfig": "tsconfig.json",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
