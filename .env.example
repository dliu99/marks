# Optional: migrate an existing session from a legacy backend you operate.
# Leave unset for fresh sign-ins and standalone use.
EXPO_PUBLIC_API_URL=

# Optional: anonymous interaction analytics for your own PostHog project.
# Leave the key empty to disable analytics. EXPO_PUBLIC values are bundled publicly.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
